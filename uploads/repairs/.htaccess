# Allow static media; block script execution
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|asp|aspx|exe|sh|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes
