<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://www.eclipse.org/uml2/3.0.0/UML">
  <uml:Model xmi:id="model_RAPID" name="RAPID">
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_Guest" name="Guest"/>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_Customer" name="Customer"/>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_Technician" name="Technician"/>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_Admin" name="Admin"/>
    <packagedElement xmi:type="uml:Actor" xmi:id="actor_AI" name="AI Assistant"/>

    <packagedElement xmi:type="uml:Package" xmi:id="pkg_booking" name="Repair Booking and Ticketing">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Book" name="Book Repair">
        <include xmi:id="inc_Book_Device" addition="uc_Device"/>
        <include xmi:id="inc_Book_Problem" addition="uc_Problem"/>
        <include xmi:id="inc_Book_Media" addition="uc_Media"/>
        <include xmi:id="inc_Book_Appt" addition="uc_Appt"/>
        <include xmi:id="inc_Book_TicketNo" addition="uc_TicketNo"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Device" name="Capture Device Details"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Problem" name="Describe Problem"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Media" name="Upload Before-Repair Media"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Appt" name="Set Appointment and Priority"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_TicketNo" name="Generate Ticket Number"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Assign" name="Assign Technician"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Received" name="Mark Device Received"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Assigned" name="View Assigned Tickets">
        <extensionPoint xmi:id="ep_Assigned_Update" name="Update progress"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Update" name="Update Repair Progress">
        <extend xmi:id="ext_Update_Assigned" extendedCase="uc_Assigned"/>
        <extensionPoint xmi:id="ep_Update_Warranty" name="Issue warranty"/>
        <extensionPoint xmi:id="ep_Update_Media" name="Attach repair media"/>
      </packagedElement>
    </packagedElement>

    <packagedElement xmi:type="uml:Package" xmi:id="pkg_tracking" name="Live Progress Tracking">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Public" name="Track Public Ticket">
        <include xmi:id="inc_Public_EnterNo" addition="uc_EnterNo"/>
        <extensionPoint xmi:id="ep_Public_Verify" name="Verify contact"/>
        <extensionPoint xmi:id="ep_Public_Timeline" name="Show timeline"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_EnterNo" name="Enter Ticket Number"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Verify" name="Verify Contact Details">
        <extend xmi:id="ext_Verify_Public" extendedCase="uc_Public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Timeline" name="View Status Timeline">
        <extend xmi:id="ext_Timeline_Public" extendedCase="uc_Public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_MyRepairs" name="View My Repairs">
        <extensionPoint xmi:id="ep_MyRepairs_Progress" name="Open ticket"/>
        <extensionPoint xmi:id="ep_MyRepairs_Notify" name="Open notifications"/>
        <extensionPoint xmi:id="ep_MyRepairs_Warranty" name="Open warranty"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Progress" name="View Ticket Progress">
        <extend xmi:id="ext_Progress_MyRepairs" extendedCase="uc_MyRepairs"/>
        <extensionPoint xmi:id="ep_Progress_Quote" name="Quotation decision"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Notify" name="View Notifications">
        <extend xmi:id="ext_Notify_MyRepairs" extendedCase="uc_MyRepairs"/>
        <extensionPoint xmi:id="ep_Notify_Read" name="Mark as read"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_MarkRead" name="Mark Notifications Read">
        <extend xmi:id="ext_MarkRead_Notify" extendedCase="uc_Notify"/>
      </packagedElement>
    </packagedElement>

    <packagedElement xmi:type="uml:Package" xmi:id="pkg_diagnosis" name="Diagnosis and Quotations">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Diag" name="Record Diagnosis">
        <extensionPoint xmi:id="ep_Diag_Recommend" name="Recommend action"/>
        <extensionPoint xmi:id="ep_Diag_AI" name="Ask AI assistant"/>
        <extensionPoint xmi:id="ep_Diag_Media" name="Attach repair media"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Recommend" name="Recommend Repair Action">
        <extend xmi:id="ext_Recommend_Diag" extendedCase="uc_Diag"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_AISuggest" name="Request AI Suggestions">
        <extend xmi:id="ext_AISuggest_Diag" extendedCase="uc_Diag"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_RepairMedia" name="Upload Repair Media">
        <extend xmi:id="ext_RepairMedia_Diag" extendedCase="uc_Diag"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Quote" name="Create Quotation">
        <include xmi:id="inc_Quote_Totals" addition="uc_Totals"/>
        <include xmi:id="inc_Quote_Send" addition="uc_Send"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Totals" name="Calculate Quotation Totals"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Send" name="Send Quotation"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Approve" name="Approve Quotation">
        <extend xmi:id="ext_Approve_Progress" extendedCase="uc_Progress"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Decline" name="Decline Quotation">
        <extend xmi:id="ext_Decline_Progress" extendedCase="uc_Progress"/>
      </packagedElement>
    </packagedElement>

    <packagedElement xmi:type="uml:Package" xmi:id="pkg_warranty" name="Warranty and Claims">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_StartW" name="Start Warranty on Completion">
        <extend xmi:id="ext_StartW_Update" extendedCase="uc_Update"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ViewW" name="View Warranty Status">
        <extend xmi:id="ext_ViewW_MyRepairs" extendedCase="uc_MyRepairs"/>
        <extensionPoint xmi:id="ep_ViewW_Claim" name="File claim"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_FileC" name="File Warranty Claim">
        <extend xmi:id="ext_FileC_ViewW" extendedCase="uc_ViewW"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_ProcC" name="Process Warranty Claim">
        <include xmi:id="inc_ProcC_Decide" addition="uc_Decide"/>
        <include xmi:id="inc_ProcC_Resolve" addition="uc_Resolve"/>
        <extensionPoint xmi:id="ep_ProcC_Assign" name="Assign technician"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Decide" name="Approve or Reject Claim"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_AssignC" name="Assign Claim Technician">
        <extend xmi:id="ext_AssignC_ProcC" extendedCase="uc_ProcC"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Resolve" name="Resolve Claim"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Package" xmi:id="pkg_shop" name="Role-Based Shop Management">
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Cust" name="Manage Customers">
        <extensionPoint xmi:id="ep_Cust_Edit" name="Add or edit"/>
        <extensionPoint xmi:id="ep_Cust_Status" name="Change status"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_CustEdit" name="Add or Edit Customer">
        <extend xmi:id="ext_CustEdit_Cust" extendedCase="uc_Cust"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_CustStatus" name="Activate or Deactivate Customer">
        <extend xmi:id="ext_CustStatus_Cust" extendedCase="uc_Cust"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Techs" name="Manage Technicians">
        <extensionPoint xmi:id="ep_Techs_Edit" name="Add or edit"/>
        <extensionPoint xmi:id="ep_Techs_Status" name="Change status"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_TechEdit" name="Add or Edit Technician">
        <extend xmi:id="ext_TechEdit_Techs" extendedCase="uc_Techs"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_TechStatus" name="Activate or Deactivate Technician">
        <extend xmi:id="ext_TechStatus_Techs" extendedCase="uc_Techs"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_Reports" name="View Reports">
        <extensionPoint xmi:id="ep_Reports_Tickets" name="Ticket report"/>
        <extensionPoint xmi:id="ep_Reports_Charts" name="Repair charts"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_TicketReports" name="View Ticket Reports">
        <extend xmi:id="ext_TicketReports_Reports" extendedCase="uc_Reports"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_RepairCharts" name="View Repair Charts">
        <extend xmi:id="ext_RepairCharts_Reports" extendedCase="uc_Reports"/>
      </packagedElement>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_CfgAI" name="Configure AI Assistant"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Association" xmi:id="as_Guest_Public">
      <ownedEnd xmi:id="as_Guest_Public_e1" type="actor_Guest" association="as_Guest_Public"/>
      <ownedEnd xmi:id="as_Guest_Public_e2" type="uc_Public" association="as_Guest_Public"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="as_Guest_Verify">
